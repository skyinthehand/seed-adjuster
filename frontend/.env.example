# Google OAuth 2.0 client ID (browser-only token client, no client secret).
# See docs/google-oauth-setup.md for how to obtain this. Billing must stay disabled
# on the backing Google Cloud project (research.md #0).
VITE_GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID

# Base URL of the control-plane (Cloudflare Workers) API this frontend build talks to.
# e.g. https://seed-adjuster-control-plane.<account>.workers.dev
VITE_CONTROL_PLANE_API_BASE_URL=REPLACE_WITH_CONTROL_PLANE_API_BASE_URL
